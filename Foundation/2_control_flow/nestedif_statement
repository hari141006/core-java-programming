
// Definition:
// A nested if means placing one if statement inside another if.
// It is useful when one condition depends on another condition.

public class nestedif_statement {
    public static void main(String[] args) {

        int age = 20;
        boolean hasID = true;

        if (age >= 18) {

            if (hasID) {
                System.out.println("Entry allowed.");
            }
        }
    }
}